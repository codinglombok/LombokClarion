    "type": "library",
    "license": "Apache-2.0",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*",
        "ext-fileinfo": "*",
        "lombokclarion/http": "*",
        "lombokclarion/i18n": "*"
    },
    "autoload": {
        "psr-4": {
            "LombokClarion\\Validation\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.2.x-dev"
        }
    }
}

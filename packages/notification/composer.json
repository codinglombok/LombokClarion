{
    "name": "lombokclarion/notification",
    "description": "Channel-based notifications: mail, database, log. Notifiable interface, explicit channel registration, queued dispatch via Bus.",
    "type": "library",
    "keywords": ["notification", "lombokclarion"],
    "license": "Apache-2.0",
    "homepage": "https://github.com/codinglombok/LombokClarion",
    "require": {
        "php": ">=8.3",
        "lombokclarion/bus": "*"
    },
    "suggest": {
        "lombokclarion/mail": "Required for the MailChannel.",
        "lombokclarion/persistence": "Required for the DatabaseChannel."
    },
    "autoload": {
        "psr-4": {
            "LombokClarion\\Notification\\": "src/"
        }
    },
    "extra": {
        "branch-alias": { "dev-main": "2.2.x-dev" }
    }
}

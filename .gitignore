# Dependencies (all path repos, but installed into vendor/ locally)
/vendor/
/node_modules/

# Secrets — .env.example is committed, .env is not
.env

# Build artifacts, all regenerated by php bin/lombokclarion optimize.
# These are the compiled twins of source that IS committed (config/, routes,
# services.php, resources/); committing them would let a stale artifact ship.
/storage/*.compiled.php
/storage/assets.manifest.php
/public/assets/*
!/public/assets/.gitkeep

# Runtime state
/storage/*.sqlite
/storage/app/*
!/storage/app/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep

# Sandbox / CI scratch
/phpstan.phar
/autoload.php.shim
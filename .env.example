# Local dev server (see docs/DEPLOYMENT.md §Local dev server): without these,
# a bare `php -S ... -t public` 500s ON PURPOSE — unset APP_ENV counts as
# production and the #44 guard refuses the default/short APP_KEY. Either keep
# this .env, or inline them:
#   APP_ENV=local APP_KEY=$(openssl rand -hex 32) php -S localhost:8000 -t public
APP_ENV=local
APP_DEBUG=true
APP_KEY=change-me-to-a-random-32-byte-secret

DB_DRIVER=sqlite
DB_PATH=storage/database.sqlite

THEME_STYLE=resonant-stark

# Stage 10 — named connections (all optional; defaults in bootstrap/services.php)
# DB_REPORTING_PATH=storage/reporting.sqlite
# DB_TENANT_DSN=sqlite:storage/tenants/{database}.sqlite
# Read/write split (leave READ empty for none):
# DB_DSN=pgsql:host=primary;dbname=app
# DB_READ_DSN=pgsql:host=replica;dbname=app

# One-shot: password for `lombokclarion user:create <email>` (env, never argv)
# LOMBOKCLARION_PASSWORD=
